# The repository is authored on Windows and built on three platforms.
# Normalising to LF in the object database keeps diffs and CI identical
# everywhere; checkouts stay LF for source and scripts.

* text=auto eol=lf

# Windows tooling expects CRLF in these.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.ico binary
*.png binary

# Keep generated lockfiles out of language statistics.
pnpm-lock.yaml linguist-generated=true
Cargo.lock linguist-generated=true
