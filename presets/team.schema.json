{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hyperpane.app/schemas/team.schema.json",
  "title": "HyperPane team preset",
  "description": "A reusable multi-agent run: who works, in what order, behind which gates, and when to stop.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "teams"],
  "properties": {
    "version": {
      "type": "integer",
      "description": "Schema version. Bumped when a field changes meaning.",
      "const": 1
    },
    "teams": {
      "type": "array",
      "items": { "$ref": "#/definitions/team" }
    }
  },
  "definitions": {
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "purpose", "archetype", "stop", "waves"],
      "properties": {
        "key": {
          "type": "string",
          "description": "Stable identifier. Never reused for different behaviour.",
          "pattern": "^[a-z][a-z0-9-]{1,40}$"
        },
        "title": { "$ref": "#/definitions/localised" },
        "purpose": {
          "description": "One sentence, shown in the picker. What is true when the run ends.",
          "$ref": "#/definitions/localised"
        },
        "group": {
          "type": "string",
          "description": "Picker grouping.",
          "enum": ["dev", "quality", "research", "writing", "ops", "growth"]
        },
        "archetype": {
          "type": "string",
          "description": "High-level shape of the run; sets sensible defaults for gates and stop rules.",
          "enum": [
            "reviewer",
            "pipeline",
            "researcher",
            "drafter",
            "operator",
            "control"
          ]
        },
        "gates": {
          "type": "array",
          "description": "Human or checker checkpoints. Order is the order they are reached.",
          "items": {
            "type": "string",
            "enum": ["humanPlan", "checkerPass", "humanCommit"]
          },
          "default": ["checkerPass"]
        },
        "stop": { "$ref": "#/definitions/stop" },
        "waves": {
          "type": "array",
          "description": "Members grouped by wave. A wave starts only when the previous one has cleared its gates.",
          "minItems": 1,
          "items": { "$ref": "#/definitions/wave" }
        },
        "starterPrompt": {
          "$ref": "#/definitions/localised",
          "description": "What the person is asked for when the team is opened."
        }
      }
    },
    "wave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wave", "roles"],
      "properties": {
        "wave": { "type": "integer", "minimum": 0 },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/role" }
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "agents", "focus"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,40}$"
        },
        "label": { "$ref": "#/definitions/localised" },
        "kind": {
          "type": "string",
          "enum": ["leader", "checker", "worker"]
        },
        "agents": {
          "type": "array",
          "description": "Agent ids, most preferred first. A run picks the first one installed.",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "count": { "type": "integer", "minimum": 1, "default": 1 },
        "focus": {
          "type": "string",
          "description": "The role's standing instruction. Becomes part of the child's brief.",
          "minLength": 1
        },
        "readOnly": {
          "type": "boolean",
          "description": "A read-only role gets no worktree and must not edit files.",
          "default": false
        },
        "worktree": {
          "type": "boolean",
          "description": "Give this role its own git worktree so parallel writers cannot collide.",
          "default": false
        },
        "tier": {
          "type": "string",
          "description": "Model budget hint for the router.",
          "enum": ["fast", "mid", "strong"],
          "default": "mid"
        }
      }
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxRounds", "maxSpawns", "wallMinutes"],
      "properties": {
        "maxRounds": { "type": "integer", "minimum": 1, "maximum": 10 },
        "maxSpawns": { "type": "integer", "minimum": 1, "maximum": 32 },
        "wallMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 480,
          "description": "Hard wall clock for the whole run."
        },
        "onStall": {
          "type": "string",
          "enum": ["escalate", "stop"],
          "default": "escalate"
        }
      }
    },
    "localised": {
      "type": "object",
      "description": "Language-tagged text. At least one language is required.",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
